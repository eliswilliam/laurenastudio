FROM node:20-slim AS frontend-build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_RECAPTCHA_SITE_KEY
ENV VITE_RECAPTCHA_SITE_KEY=$VITE_RECAPTCHA_SITE_KEY
RUN npm run build

# ────────────────────────────────────────────────────────────

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev curl netcat-openbsd nginx supervisor redis-server \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

# Cloud SQL Auth Proxy — used in production for mTLS + IAM auth to Cloud SQL.
# Inert when CLOUD_SQL_INSTANCE is unset (local dev with docker-compose).
ARG CLOUD_SQL_PROXY_VERSION=2.14.3
RUN curl -fsSL -o /usr/local/bin/cloud-sql-proxy \
        https://storage.googleapis.com/cloud-sql-connectors/cloud-sql-proxy/v${CLOUD_SQL_PROXY_VERSION}/cloud-sql-proxy.linux.amd64 \
 && chmod +x /usr/local/bin/cloud-sql-proxy

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

RUN mkdir -p /usr/share/nginx/html
COPY --from=frontend-build /app/dist /usr/share/nginx/html/

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

RUN chmod +x scripts/docker-entrypoint-api-azure.sh 2>/dev/null || true
RUN chmod +x scripts/docker-entrypoint-combined.sh
RUN chmod +x scripts/start-cloud-sql-proxy.sh

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=5 \
    CMD curl -f http://127.0.0.1:8080/health || exit 1

# Production: alembic then supervisord. CI sets SKIP_ALEMBIC=1 for smoke tests without Postgres.
CMD ["/app/scripts/docker-entrypoint-combined.sh"]
