FROM node:20-slim

WORKDIR /app

# Install dependencies first (layer-cached)
COPY package*.json ./
RUN npm install

# Copy source (will be overridden by volume mount in dev)
COPY . .

EXPOSE 8080

# Vite dev server — --host makes it accessible outside the container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
