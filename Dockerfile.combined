FROM node:20-alpine AS frontend-build

WORKDIR /build

ARG VITE_ROOT_DOMAIN=laurenastudio.pro
ENV VITE_ROOT_DOMAIN=$VITE_ROOT_DOMAIN

# Copy only frontend dependencies and config
COPY package*.json vite.config.ts tsconfig*.json postcss.config.js tailwind.config.ts ./
COPY public/ ./public/
COPY src/ ./src/
COPY index.html ./

RUN npm ci

RUN npm run build

# ────────────────────────────────────────────────────────────

FROM python:3.11-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev curl nginx supervisor \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend source
COPY backend/ .

# Copy built frontend assets
RUN mkdir -p /usr/share/nginx/html
COPY --from=frontend-build /build/dist/ /usr/share/nginx/html/

# Copy nginx & supervisor configs
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

RUN chmod +x scripts/docker-entrypoint-api-azure.sh

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=5 \
    CMD curl -f http://127.0.0.1:8080/health || exit 1

CMD ["sh", "-c", "alembic upgrade head && /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf"]
