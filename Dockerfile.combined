FROM node:20-slim AS frontend-build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ────────────────────────────────────────────────────────────

FROM python:3.11-slim

WORKDIR /app

# Install all needed packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev curl nginx supervisor redis-server \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ .

# Copy frontend build
RUN mkdir -p /usr/share/nginx/html
COPY --from=frontend-build /app/dist /usr/share/nginx/html/

# Copy configs
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

RUN chmod +x scripts/docker-entrypoint-api-azure.sh 2>/dev/null || true

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=5 \
    CMD curl -f http://127.0.0.1:8080/health || exit 1

CMD ["sh", "-c", "alembic upgrade head 2>&1 || true && /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf"]
