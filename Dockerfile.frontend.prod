# Stage 1: Build the React app
FROM node:20-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Stage 2: Serve with nginx — minimal like ce9d4de (no separate entrypoint file).
# nginx.conf targets http://api:8000 for Azure multi-container (not localhost).
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["sh", "-c", "i=0; while [ $$i -lt 240 ]; do wget -q -T 5 -O- http://api:8000/health >/dev/null 2>&1 && exec nginx -g 'daemon off;'; i=$$((i+1)); sleep 2; done; echo 'timeout waiting for api'; exit 1"]
