# Copy to .env and fill in values. Do not commit .env with secrets.

# Pexels API — stock photos for generated sites (https://www.pexels.com/api/)
# Use either name (both are read into PEXELS_API_KEY in the app):
PEXELS_API_KEY=
# PEXELS_TOKEN=
# Optional: set false on Azure until keys are ready (site generation still works, no Pexels calls):
# SITE_USE_PEXELS_STOCK=true

# ── Google Cloud — publish (GitHub → Cloud Run) & Indexing API ───────────────
# Same service account JSON as for Cloud Run / domain mapping: GCP_SA_KEY (plain JSON or base64).
# GOOGLE_CREDENTIALS_JSON is used as fallback if GCP_SA_KEY is empty (Vertex / legacy).
# GCP_PROJECT_ID=
# GCP_SA_KEY=
# GCP_REGION=us-central1

# Cloudflare + public URL https://{slug}.{ROOT_DOMAIN} (required for subdomain publish + indexing below)
# CLOUDFLARE_TOKEN=
# CLOUDFLARE_ZONE_ID=
# ROOT_DOMAIN=example.com

# ── Google Indexing API (notify Search after « Publicar » on a subdomain) ────
# Prérequis GCP : activer l’API « Indexing API » sur le même projet que GCP_SA_KEY.
# Prérequis Search Console : ajouter le compte de service (client_email du JSON) comme
#   propriétaire de la propriété couvrant vos sous-domaines (ex. propriété Domaine sur ROOT_DOMAIN).
# Sans cela, les appels renvoient 403 (voir logs worker).
# Dépendance Python : google-api-python-client (voir requirements.txt). Redémarrer API + worker ARQ après install.
GOOGLE_INDEXING_ENABLED=true

# ── Azure Speech (text-to-speech, POST /api/v1/ai/speech/synthesize) ─────────
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/
# AZURE_SPEECH_VOICE=en-US-Ava:DragonHDLatestNeural
# Délai (secondes) après le clic Publicar avant l’envoi à Google (défaut 5400 = 1 h 30).
GOOGLE_INDEXING_DEFER_SECONDS=5400
