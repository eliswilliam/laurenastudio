# ── Laurena Studio — environment variables ─────────────────────────────────
# Copy this file to .env and fill in your values.

# App
APP_NAME="Laurena Studio"
APP_VERSION="1.0.0"
DEBUG=false

# Database (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:example@localhost:5432/laurenadb

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_32_BYTE_HEX_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password reset
RESET_TOKEN_EXPIRE_MINUTES=30

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session (required by SessionMiddleware for OAuth flow)
SESSION_SECRET_KEY=REPLACE_WITH_SESSION_SECRET

# Frontend / Backend URLs
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8000

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Per-plan Stripe Price IDs (subscription mode)
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_BUSINESS=price_...

# CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]
